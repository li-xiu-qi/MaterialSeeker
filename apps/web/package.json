{
  "name": "materialseeker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 9280",
    "build": "next build",
    "start": "next start --port 9280",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:light": "bash scripts/test-light-mode.sh",
    "test:fts": "bash scripts/test-fts-segment.sh",
    "check": "npm run lint && tsc --noEmit && vitest run && npm run test:light && npm run test:fts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
