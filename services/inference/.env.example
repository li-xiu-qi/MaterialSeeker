# 推理服务环境变量模板。cp .env.example .env 后填写，.env 不入库。
# API Key 获取与配置说明见 ../../docs/configuration.md。
# 两个服务共用本文件，按需取用。

# 部署档位：light = ASR + 画面描述 + 关键词检索；standard = 轻量能力 + 向量语义增强。
# 轻量版不加载 EmbeddingGemma 2，也不启用本地 FunASR 兜底，ASR 必须使用云端 provider。
MATERIALSEEKER_PROFILE=standard
# 轻量版改为 MATERIALSEEKER_PROFILE=light，启动脚本使用下面的解释器，依赖见 requirements-light.txt。
MATERIALSEEKER_LIGHT_PYTHON=/path/to/venv/bin/python
# 标准版解释器由 start.sh 固定为 eg2-env 与 hearsight-env。

# ---------- embedding 服务（:8280）----------
# EmbeddingGemma 2（多模态统一编码器：文本/代码/图片/视频/音频 → 同一向量空间）
# 本地权重目录（hf-mirror 下载，1.5G）
MATERIALSEEKER_MODEL=/path/to/models/embeddinggemma-2
# 目标维度。EG2 原生 768，MRL 可截 512/256/128。默认 768。
# 改维度必须三处同步：业务仓 db.ts 的 VECTOR_DIM、业务仓 embed.ts 的校验、这里
MATERIALSEEKER_DIM=768

# ---------- 视频处理服务（:8281）----------
# ffmpeg 二进制绝对路径（micromamba 用户态安装），指向文件不是目录
FFMPEG_BIN=/path/to/ffmpeg

# ---------- 两个服务共用的在线视觉模型（caption / 帧分析）----------
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
# 视觉模型选型（2026-10-08 实测定稿）：
#   glm-4v-flash    免费档，5 连打 5 成功、平均 0.9s、JSON 格式干净。它是上一代免费
#                   视觉档里用量最大的一档，热度高则平台容量相对稳定。**已从官方价格表
#                   退役**，不再承诺免费与可用性，但接口仍通，是当前零成本首选。
#   glm-4.6v-flash  同样已退役，且 5 连打全部 1305 平台过载（0% 成功），不可用。
#   glm-5.3-flash   付费档 ¥0.8/M 输入 / ¥2.8/M 输出，全模态，glm-4v-flash 彻底
#                   下线时的切换目标（需账号有余额）。
# 失效判据：连续 3 帧标注失败（ingestVideo 的熔断阈值）即视为该档不可用，
# 届时改这两个环境变量并重启 8281 即可，业务仓代码不用动。
VISION_MODEL=glm-4v-flash
VS_ANALYZE_MODEL=glm-4v-flash

# ---------- 可选：阿里云 DashScope 画面描述 ----------
# 设置 DASHSCOPE_API_KEY 后优先于 GLM_API_KEY，两个密钥二选一。
# DASHSCOPE_API_KEY=
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3-vl-plus
# VS_ANALYZE_MODEL=qwen3-vl-plus

# ---------- ASR provider（2026-10-08 定：云端优先，本地兜底）----------
# local = FunASR Paraformer（默认，行为与上版完全一致）
# siliconflow = 硅基 XingChenASR-V3.2 免费档
# 实测依据：硅基 60 连打零 429（约 53 次/分钟）、360.2 秒音频 24.18 秒
# （RTF 0.067）、长音频无惩罚；本地 FunASR CPU RTF 0.16 且懒加载首次要等
# 模型进内存。切回本地只改这一个变量，端点契约不变。
ASR_PROVIDER=siliconflow
ASR_CLOUD_BASE_URL=https://api.siliconflow.cn
ASR_CLOUD_KEY=
ASR_CLOUD_MODEL=XingChenAGI/XingChenASR-V3.2
# 硅基上限「≤1 小时 / ≤50MB」，但更紧的是体积：16k 单声道 pcm_s16le 是
# 32KB/s，50MB 只装约 26 分钟。字节数默认留 10% 余量（multipart 头也占）。
# 超限时不回退本地，而是先把 wav 转成 mp3 再传（体积约 1/10，识别率影响
# 可忽略）——长视频正是上云的主要收益场景，回落本地要等十分钟级。
ASR_CLOUD_MAX_BYTES=47185920
ASR_CLOUD_MAX_MS=3600000
